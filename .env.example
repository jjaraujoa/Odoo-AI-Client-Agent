# Copie este archivo como .env y ejecute scripts/Initialize-Pilot.ps1.
# No use estos valores de ejemplo en producción.

COMPOSE_PROJECT_NAME=odoo_ai_agent_pilot
TZ=America/Bogota

# Versiones verificadas al 28-07-2026. Revise notas de versión antes de actualizar.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.30.5
POSTGRES_IMAGE=postgres:17.10-alpine
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.7.2
CLAMAV_IMAGE=clamav/clamav:1.5.2

POSTGRES_DB=odoo_ai_agent
POSTGRES_USER=odoo_ai
POSTGRES_PASSWORD=CAMBIAR_CON_SCRIPT

# n8n
N8N_ENCRYPTION_KEY=CAMBIAR_CON_SCRIPT
N8N_OWNER_EMAIL=admin@example.invalid
N8N_WEBHOOK_URL=https://REEMPLAZAR.example.com/
N8N_PORT=5678
N8N_EXECUTION_ERROR_RETENTION_HOURS=168

# API interna: n8n usa esta clave para llamar a control-api.
CONTROL_API_INTERNAL_KEY=CAMBIAR_CON_SCRIPT
CONTROL_API_ADMIN_KEY=CAMBIAR_CON_SCRIPT
CONTROL_API_PORT=8080

# AES-256-GCM: exactamente 32 bytes, codificados en base64.
ODOO_CREDENTIAL_MASTER_KEY_B64=CAMBIAR_CON_SCRIPT

# OpenAI es administrado por la plataforma. Anthropic permanece vacío por ahora.
# El token de Telegram se importa desde .odooai y se cifra por cliente; no va aquí.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Opcional: token de un túnel nombrado de Cloudflare.
CLOUDFLARE_TUNNEL_TOKEN=

# El piloto acepta únicamente PDF/JPEG/PNG, 5 MiB y hasta 10 páginas por política.
MAX_DOCUMENT_BYTES=5242880
MAX_DOCUMENT_PAGES=10
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# En WSL nativo se sobrescribe con /run/clamav/clamd.ctl.
CLAMAV_SOCKET=
CLAMAV_REQUIRED=true

# Los IDs proporcionados por el usuario se siembran desactivados y pendientes
# de validación. No existe una bandera para saltarse esa validación.
